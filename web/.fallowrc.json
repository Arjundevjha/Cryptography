{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}"
  ],
  "ignoreDependencies": [
    "tailwindcss"
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  "ignoreExports": [
    {
      "file": "src/components/museum/museumData.ts",
      "exports": ["*"]
    },
    {
      "file": "src/components/museum/workbench/PassportChallengeView.tsx",
      "exports": ["*"]
    }
  ]
}
